<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"

            fx:controller="org.example.ui.controller.ListadoOfertasController"

            prefWidth="1000" prefHeight="650">
    <top>
        <VBox spacing="10">
            <padding>
                <Insets top="15" right="15" bottom="10" left="15"/>
            </padding>
            <Label text="Candidaturas laborales" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
            <HBox spacing="10">
                <TextField fx:id="txtBuscar" promptText="Buscar puesto o empresa..." HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="cmbEstado" promptText="Estado"/>
                <Button text="Filtrar" onAction="#filtrar"/>
                <Button text="Limpiar" onAction="#limpiarFiltros"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <TableView fx:id="tabla">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
                <TableColumn fx:id="colTitulo" text="Título del puesto" prefWidth="260"/>
                <TableColumn fx:id="colEmpresa" text="Empresa" prefWidth="180"/>
                <TableColumn fx:id="colEstado" text="Estado" prefWidth="120"/>
                <TableColumn fx:id="colFecha" text="Fecha" prefWidth="120"/>
                <TableColumn fx:id="colSalario" text="Salario" prefWidth="100"/>
            </columns>
        </TableView>
    </center>
    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <padding>
                <Insets top="10" right="15" bottom="15" left="15"/>
            </padding>
            <Button text="Nueva oferta" onAction="#nuevaOferta"/>
            <Button text="Ver" onAction="#verOferta"/>
            <Button text="Editar" onAction="#editarOferta"/>
            <Button text="Borrar" onAction="#borrarOferta"/>
        </HBox>
    </bottom>
</BorderPane>
